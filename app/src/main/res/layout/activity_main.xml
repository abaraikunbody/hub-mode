<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hub Mode"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.7"
            android:text="Heure, date, Spotify et cours de bourse quand le téléphone est en charge et à l'horizontale." />

        <!-- 1. Activation -->
        <TextView
            style="@style/Section"
            android:text="1. Activer Hub Mode" />

        <TextView
            android:id="@+id/overlay_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Autoriser « par-dessus les autres applis »" />

        <Switch
            android:id="@+id/service_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Hub Mode activé (en charge + couché + verrouillé)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.7"
            android:text="Sur le Hub : ✕ pour revenir à l'écran de verrouillage, balayer vers le haut pour déverrouiller. Pense à désactiver l'économiseur d'écran d'Android." />

        <!-- 2. Spotify -->
        <TextView
            style="@style/Section"
            android:text="2. Autoriser Spotify" />

        <TextView
            android:id="@+id/media_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Autoriser l'accès aux notifications" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.7"
            android:text="Si l'option est grisée (« paramètre restreint ») : ouvre les infos de l'appli, menu ⋮ en haut à droite, puis « Autoriser les paramètres restreints », et réessaie." />

        <Button
            android:id="@+id/btn_appinfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ouvrir les infos de l'appli" />

        <!-- 3. ETF -->
        <TextView
            style="@style/Section"
            android:text="3. Mes ETF / actions (3 max)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="Un par ligne, au format Yahoo Finance : SYMBOLE|Nom affiché. Exemples : DCAM.PA|PEA Monde · CW8.PA|MSCI World · ESE.PA|S&amp;P 500" />

        <EditText
            android:id="@+id/tickers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:inputType="textMultiLine|textNoSuggestions|textCapCharacters"
            android:minLines="3" />

        <!-- 4. Options -->
        <TextView
            style="@style/Section"
            android:text="4. Options" />

        <Switch
            android:id="@+id/night_dim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atténuer l'affichage la nuit (22h – 7h)" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Enregistrer" />

        <Button
            android:id="@+id/btn_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Aperçu" />

        <TextView
            style="@style/Section"
            android:text="5. Journal de diagnostic" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Effacer le journal" />

        <TextView
            android:id="@+id/journal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
