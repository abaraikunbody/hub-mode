<?xml version="1.0" encoding="utf-8"?>
<!-- Écran principal du mode Hub (format paysage). Le RotatingLayout le remet
     à l'endroit si Android garde l'écran de veille en portrait. -->
<com.perso.hubmode.RotatingLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rotator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="36dp"
            android:paddingTop="24dp"
            android:paddingEnd="36dp"
            android:paddingBottom="24dp">

            <!-- Colonne gauche : heure, date, batterie, ETF -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="#FFFFFF"
                    android:textSize="96sp" />

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:format12Hour="EEEE d MMMM"
                    android:format24Hour="EEEE d MMMM"
                    android:textColor="#D0FFFFFF"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="2dp"
                    android:textColor="#8AFFFFFF"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/etfs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Colonne droite : lecteur Spotify -->
            <LinearLayout
                android:id="@+id/media_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="28dp"
                android:layout_weight="0.85"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/art"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:background="@drawable/art_bg"
                        android:contentDescription="Pochette"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/media_app"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Spotify"
                            android:textColor="#1DB954"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#B3FFFFFF"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:max="1000"
                    android:progressBackgroundTint="#40FFFFFF"
                    android:progressTint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#8AFFFFFF"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/dur"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#8AFFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/prev"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Précédent"
                        android:scaleType="center"
                        android:src="@drawable/ic_prev"
                        android:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/play"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:background="@drawable/play_bg"
                        android:contentDescription="Lecture / pause"
                        android:scaleType="center"
                        android:src="@drawable/ic_play"
                        android:tint="#000000" />

                    <ImageButton
                        android:id="@+id/next"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Suivant"
                        android:scaleType="center"
                        android:src="@drawable/ic_next"
                        android:tint="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/media_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="#8AFFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:alpha="0.35"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fermer"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF" />
    </FrameLayout>
</com.perso.hubmode.RotatingLayout>
